{
  "task_name": "Session Compression Auto-Check",
  "description": "每 2 小时自动检查并压缩会话",
  "enabled": true,
  "schedule": {
    "type": "interval",
    "interval_hours": 2,
    "start_time": "00:00",
    "end_time": "23:59"
  },
  "command": {
    "executable": "python",
    "arguments": [
      "30-scripts-tools/auto_session_compressor.py",
      "--auto"
    ],
    "working_directory": "D:/OpenClaw/workspace"
  },
  "conditions": {
    "max_context_size_kb": 100,
    "target_size_kb": 5,
    "min_compression_rate": 0.8
  },
  "notifications": {
    "on_success": false,
    "on_failure": true,
    "on_large_file": true
  },
  "logging": {
    "log_file": "13-memory/session-compression-log.jsonl",
    "max_log_entries": 100,
    "log_level": "INFO"
  }
}
