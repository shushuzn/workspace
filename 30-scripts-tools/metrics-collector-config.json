{
  "name": "OpenClaw Metrics Collector",
  "version": "1.0.0",
  "created": "2026-03-13",
  "description": "Performance metrics collection configuration (Critic v5.0 fix-009)",
  
  "metrics": {
    "task_execution": {
      "enabled": true,
      "collect_interval_seconds": 60,
      "metrics": [
        {
          "name": "task_count",
          "type": "counter",
          "description": "Total tasks executed"
        },
        {
          "name": "task_duration_seconds",
          "type": "histogram",
          "description": "Task execution duration",
          "buckets": [10, 30, 60, 300, 600, 1800, 3600]
        },
        {
          "name": "task_success_rate",
          "type": "gauge",
          "description": "Task success rate (0-1)"
        }
      ]
    },
    
    "system_performance": {
      "enabled": true,
      "collect_interval_seconds": 300,
      "metrics": [
        {
          "name": "cpu_usage_percent",
          "type": "gauge",
          "description": "CPU usage percentage"
        },
        {
          "name": "memory_usage_mb",
          "type": "gauge",
          "description": "Memory usage in MB"
        },
        {
          "name": "disk_usage_percent",
          "type": "gauge",
          "description": "Disk usage percentage"
        }
      ]
    },
    
    "api_performance": {
      "enabled": true,
      "collect_interval_seconds": 60,
      "metrics": [
        {
          "name": "api_request_count",
          "type": "counter",
          "description": "Total API requests"
        },
        {
          "name": "api_latency_ms",
          "type": "histogram",
          "description": "API response latency",
          "buckets": [50, 100, 200, 500, 1000, 2000, 5000]
        },
        {
          "name": "api_error_rate",
          "type": "gauge",
          "description": "API error rate (0-1)"
        }
      ]
    },
    
    "quality_metrics": {
      "enabled": true,
      "collect_interval_seconds": 3600,
      "metrics": [
        {
          "name": "critic_score",
          "type": "gauge",
          "description": "Critic v5.0 quality score (0-100)"
        },
        {
          "name": "documentation_coverage",
          "type": "gauge",
          "description": "Documentation coverage percentage"
        },
        {
          "name": "test_pass_rate",
          "type": "gauge",
          "description": "Test pass rate (0-1)"
        }
      ]
    }
  },
  
  "storage": {
    "type": "sqlite",
    "path": "91-logs-日志/metrics.db",
    "retention_days": 90
  },
  
  "export": {
    "enabled": true,
    "format": "json",
    "path": "91-logs-日志/metrics-export",
    "schedule": "0 0 * * *"
  },
  
  "alerts": {
    "enabled": true,
    "rules": [
      {
        "name": "high_cpu",
        "condition": "cpu_usage_percent > 80",
        "severity": "warning"
      },
      {
        "name": "low_success_rate",
        "condition": "task_success_rate < 0.9",
        "severity": "critical"
      },
      {
        "name": "high_api_latency",
        "condition": "api_latency_ms_p95 > 2000",
        "severity": "warning"
      }
    ]
  }
}
