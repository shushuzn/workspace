{
  "workflow_id": "session-end",
  "name": "Session End Workflow",
  "description": "会话结束工作流 - 16 步自动化流程（含 P1 修复）",
  "version": "3.1",
  "last_updated": "2026-03-18",
  "principles": [
    "只引用 tool_id，禁止硬编码命令",
    "实时从工具库拉取最新定义",
    "参数只覆盖非核心配置"
  ],
  "steps": [
    {
      "step_id": 1,
      "name": "Session Compression",
      "description": "压缩会话到结构化摘要",
      "tool_id": "session-compress",
      "stage": "pre-commit",
      "parameters": {},
      "blocking": true,
      "timeout_seconds": 30
    },
    {
      "step_id": 2,
      "name": "Context Size Verification",
      "description": "验证上下文大小<100KB",
      "tool_id": "context-verify",
      "stage": "pre-commit",
      "parameters": {},
      "blocking": true,
      "timeout_seconds": 10
    },
    {
      "step_id": 3,
      "name": "Daily Note Check",
      "description": "检查当日笔记<100 行",
      "tool_id": "session-compress",
      "stage": "pre-commit",
      "parameters": {},
      "blocking": true,
      "timeout_seconds": 10,
      "note": "复用 session-compress，它已包含行数检查"
    },
    {
      "step_id": 4,
      "name": "Memory Importance Assessment",
      "description": "评估当日记忆重要性（非阻塞 - 工具待开发）",
      "tool_id": "memory-importance-assessor",
      "stage": "pre-commit",
      "parameters": {
        "memory": "13-memory/${TODAY}.md"
      },
      "blocking": false,
      "timeout_seconds": 10
    },
    {
      "step_id": 5,
      "name": "Memory Consistency Check",
      "description": "记忆数据一致性检查（非阻塞 - 工具待开发）",
      "tool_id": "memory-consistency-checker",
      "stage": "pre-commit",
      "parameters": {},
      "blocking": false,
      "timeout_seconds": 30
    },
    {
      "step_id": 6,
      "name": "Tag Search Test",
      "description": "测试标签搜索功能（非阻塞 - 工具待开发）",
      "tool_id": "memory-tag-search",
      "stage": "pre-commit",
      "parameters": {
        "tag": "critical",
        "limit": 3
      },
      "blocking": false,
      "timeout_seconds": 10
    },
    {
      "step_id": 7,
      "name": "Memory Benchmark",
      "description": "记忆系统性能测试（非阻塞 - 仅周一）",
      "tool_id": "memory-benchmark",
      "stage": "pre-commit",
      "parameters": {},
      "blocking": false,
      "timeout_seconds": 60,
      "conditional": {
        "run_only_on": "Monday"
      }
    },
    {
      "step_id": 8,
      "name": "Weekly Memory Cleanup",
      "description": "每周去重清理（非阻塞 - 仅周日）",
      "tool_id": "memory-cleanup-compress",
      "stage": "pre-commit",
      "parameters": {
        "days": 7
      },
      "blocking": false,
      "timeout_seconds": 30,
      "conditional": {
        "run_only_on": "Sunday"
      }
    },
    {
      "step_id": 9,
      "name": "Weekly Quality Assessment",
      "description": "每周质量评分（非阻塞 - 仅周日）",
      "tool_id": "memory-quality-scorer",
      "stage": "pre-commit",
      "parameters": {
        "days": 14
      },
      "blocking": false,
      "timeout_seconds": 30,
      "conditional": {
        "run_only_on": "Sunday"
      }
    },
    {
      "step_id": 10,
      "name": "Weekly Hybrid Compression",
      "description": "混合压缩（非阻塞 - 仅周日）",
      "tool_id": "memory-hybrid-pipeline",
      "stage": "pre-commit",
      "parameters": {
        "days": 7
      },
      "blocking": false,
      "timeout_seconds": 60,
      "conditional": {
        "run_only_on": "Sunday"
      }
    },
    {
      "step_id": 11,
      "name": "Weekly Incremental Compression",
      "description": "增量压缩（非阻塞 - 仅周日）",
      "tool_id": "memory-incremental-compressor",
      "stage": "pre-commit",
      "parameters": {
        "days": 7
      },
      "blocking": false,
      "timeout_seconds": 30,
      "conditional": {
        "run_only_on": "Sunday"
      }
    },
    {
      "step_id": 12,
      "name": "Auto-Critic Review",
      "description": "批判者最终审查（v6.0 - 非阻塞）",
      "tool_id": "auto-critic",
      "stage": "pre-commit",
      "parameters": {
        "task": "${commit_message}",
        "phase": "final"
      },
      "blocking": false,
      "timeout_seconds": 60
    },
    {
      "step_id": 13,
      "name": "Auto-Critic v7.0 Enhanced Review",
      "description": "增强版批判者审查（非阻塞 - 问题检测 + 整改闭环 + 质量门禁）",
      "tool_id": "auto-critic-v7",
      "stage": "pre-commit",
      "parameters": {
        "task": "${commit_message}",
        "phase": "final",
        "flow_id": "${flow_id}"
      },
      "blocking": false,
      "timeout_seconds": 120
    },
    {
      "step_id": 14,
      "name": "Quality Gate Check",
      "description": "代码质量门禁检查（阻塞性 - 最低 80 分）",
      "tool_id": "quality-gate",
      "stage": "pre-commit",
      "parameters": {
        "check": "30-scripts-tools/*.py",
        "min-score": 80
      },
      "blocking": true,
      "timeout_seconds": 120
    },
    {
      "step_id": 15,
      "name": "P1 Issue Auto-Fix",
      "description": "自动修复 P1 优先级问题（阻塞性）",
      "tool_id": "p1-issue-fixer",
      "stage": "pre-commit",
      "parameters": {
        "action": "fix"
      },
      "blocking": true,
      "timeout_seconds": 120
    },
    {
      "step_id": 16,
      "name": "Issue Scanner",
      "description": "全面问题扫描（非阻塞 - 历史问题专项修复）",
      "tool_id": "issue-scanner",
      "stage": "pre-commit",
      "parameters": {
        "path": "30-scripts-tools",
        "level": "critical"
      },
      "blocking": false,
      "timeout_seconds": 120,
      "note": "历史安全问题 131 个，需专项修复，不阻塞日常工作流"
    }
  ],
  "execution_order": "sequential",
  "stop_on_blocking_failure": true,
  "output": {
    "format": "console",
    "log_file": "30-scripts-tools/workflow-execution-log.json",
    "summary": true
  },
  "post_workflow": {
    "git_operations": true,
    "note": "Git add/commit/push handled by session_end.py after workflow completion"
  }
}