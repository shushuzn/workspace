{
  "version": "1.1.0",
  "last_updated": "2026-03-18",
  "changes": [
    "Added auto-critic-v7 with issue detection and remediation tracking",
    "Added issue-scanner for comprehensive code scanning",
    "Added critical-issue-detector for high-risk issue detection",
    "Added remediation-tracker for FAIL item tracking",
    "Added quality-gate for code quality checks"
  ],
  "description": "唯一工具库 - 全系统唯一真值来源",
  "principles": [
    "唯一数据源原则：所有工具只允许有一份唯一定义",
    "引用优先原则：工作流只引用 tool_id，禁止硬编码",
    "实时生效原则：工具修改后引用自动同步生效"
  ],
  "tools": {
    "auto-critic": {
      "tool_id": "auto-critic",
      "name": "Auto-Critic v6.0",
      "description": "全自动批判者审查工具 - 事前/事中/事后全流程审查",
      "version": "6.0",
      "command": "py 30-scripts-tools\\auto-critic.py -t \"{task}\" -p {phase}",
      "parameters": {
        "task": {
          "type": "string",
          "required": true,
          "description": "任务名称（用于生成审查文件名）",
          "validation": "^[a-zA-Z0-9-_]+$"
        },
        "phase": {
          "type": "string",
          "required": true,
          "description": "审查阶段",
          "enum": ["start", "mid", "final"],
          "default": "final"
        }
      },
      "validation": {
        "review_file": "30-scripts-tools/critic-auto-{task}.json",
        "score_threshold": 95,
        "zero_score_items": [
          "批判者自动调用",
          "工具创建了必须使用",
          "当日笔记压缩<100 行",
          "会话压缩执行",
          "上下文大小验证<100KB",
          "工作区正确性 D 盘",
          "检查项必须有证据"
        ]
      },
      "triggers": ["session_end", "task_complete"],
      "review_required": true,
      "blocking": false,
      "timeout_seconds": 60
    },
    "session-compress": {
      "tool_id": "session-compress",
      "name": "Post-Session Compressor",
      "description": "会话压缩工具 - 压缩对话到结构化摘要",
      "version": "1.0",
      "command": "py 30-scripts-tools\\post_session_compress.py --auto",
      "parameters": {},
      "validation": {
        "context_size_limit_kb": 100,
        "daily_note_lines_limit": 100,
        "verify_with": "fast_load.py"
      },
      "triggers": ["session_end"],
      "review_required": true,
      "blocking": true,
      "timeout_seconds": 30
    },
    "context-verify": {
      "tool_id": "context-verify",
      "name": "Fast Load Context Verifier",
      "description": "上下文大小验证工具 - 确保<100KB",
      "version": "1.0",
      "command": "py 30-scripts-tools\\fast_load.py",
      "parameters": {},
      "validation": {
        "max_size_kb": 100,
        "core_files": [
          "SOUL.md",
          "USER.md",
          "AGENTS.md",
          "TOOLS.md",
          "HEARTBEAT.md",
          "13-memory/MEMORY.md",
          "13-memory/YYYY-MM-DD.md"
        ]
      },
      "triggers": ["session_start", "session_end"],
      "review_required": true,
      "blocking": true,
      "timeout_seconds": 10
    },
    "memory-consistency-checker": {
      "tool_id": "memory-consistency-checker",
      "name": "Memory Consistency Checker",
      "description": "记忆数据一致性检查工具 - 确保索引与数据同步",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_consistency_checker.py",
      "parameters": {},
      "validation": {
        "report_file": "30-scripts-tools/consistency_check_report.json",
        "consistency_threshold": 0.95
      },
      "triggers": ["session_end"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "memory-benchmark": {
      "tool_id": "memory-benchmark",
      "name": "Memory Benchmark",
      "description": "记忆系统性能测试工具 - 每周一自动运行",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_benchmark.py",
      "parameters": {},
      "validation": {
        "performance_targets": {
          "tag_search_ms": 1000,
          "index_generation_ms": 5000,
          "session_compression_ms": 2000,
          "full_text_search_ms": 1000,
          "memory_load_ms": 500
        },
        "schedule": "weekly_monday"
      },
      "triggers": ["session_end"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 60,
      "conditional": {
        "run_only_on": "Monday"
      }
    },
    "memory-tag-search": {
      "tool_id": "memory-tag-search",
      "name": "Memory Tag Search",
      "description": "记忆标签搜索工具 - 验证索引可用性",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_tag_search.py --tag {tag} --limit {limit}",
      "parameters": {
        "tag": {
          "type": "string",
          "required": false,
          "description": "搜索标签",
          "default": "critical"
        },
        "limit": {
          "type": "integer",
          "required": false,
          "description": "结果数量限制",
          "default": 3,
          "min": 1,
          "max": 20
        }
      },
      "validation": {
        "min_results": 1,
        "index_file": "13-memory/memory_index.json"
      },
      "triggers": ["session_end"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 10
    },
    "memory-index-generator": {
      "tool_id": "memory-index-generator",
      "name": "Memory Index Generator",
      "description": "记忆索引生成器 - 自动更新标签索引",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_index_generator.py",
      "parameters": {},
      "validation": {
        "index_file": "13-memory/memory_index.json",
        "min_entries": 10
      },
      "triggers": ["session_compress"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "memory-hybrid-pipeline": {
      "tool_id": "memory-hybrid-pipeline",
      "name": "Memory Hybrid Compression Pipeline",
      "description": "混合压缩管道 - 整合去重/质量/重要性/增量/分层压缩策略",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_hybrid_pipeline.py --batch --days {days}",
      "parameters": {
        "days": {
          "type": "integer",
          "required": false,
          "description": "处理最近 N 天",
          "default": 7,
          "min": 1,
          "max": 90
        }
      },
      "validation": {
        "quality_threshold": 0.7,
        "importance_threshold": 0.5,
        "strategies": ["distill_to_memory", "tiered_light", "tiered_standard", "tiered_heavy", "archive"]
      },
      "triggers": ["weekly_sunday"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 60
    },
    "memory-quality-scorer": {
      "tool_id": "memory-quality-scorer",
      "name": "Memory Quality Scorer",
      "description": "记忆质量评分工具 - 5 维度评分 (完整性/结构化/密度/可执行性/独特性)",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_quality_scorer.py --report --days {days}",
      "parameters": {
        "days": {
          "type": "integer",
          "required": false,
          "description": "处理最近 N 天",
          "default": 14,
          "min": 1,
          "max": 90
        }
      },
      "validation": {
        "grade_levels": ["A", "B", "C", "D", "F"],
        "dimensions": ["completeness", "structure", "density", "actionability", "uniqueness"],
        "total_score_max": 100
      },
      "triggers": ["weekly_sunday"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "memory-cleanup-compress": {
      "tool_id": "memory-cleanup-compress",
      "name": "Memory Cleanup & Deduplication",
      "description": "记忆去重清理工具 - 检测重复/冗余，清理空行/无效内容",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_cleanup_compress.py --batch --days {days}",
      "parameters": {
        "days": {
          "type": "integer",
          "required": false,
          "description": "处理最近 N 天",
          "default": 14,
          "min": 1,
          "max": 90
        },
        "threshold": {
          "type": "float",
          "required": false,
          "description": "相似度阈值",
          "default": 0.8,
          "min": 0.5,
          "max": 1.0
        }
      },
      "validation": {
        "similarity_algorithm": ["jaccard", "sequence"],
        "duplicate_types": ["exact", "near_duplicate", "partial"]
      },
      "triggers": ["weekly_sunday"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "memory-importance-assessor": {
      "tool_id": "memory-importance-assessor",
      "name": "Memory Importance Assessor",
      "description": "记忆重要性评估工具 - 5 维度评分 (可执行性/独特性/时效性/影响力/连接性)",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_importance_assessor.py --memory \"{memory}\"",
      "parameters": {
        "memory": {
          "type": "string",
          "required": true,
          "description": "记忆文件路径"
        }
      },
      "validation": {
        "dimensions": ["actionability", "uniqueness", "recency", "impact", "connectedness"],
        "weights": {
          "actionability": 0.20,
          "uniqueness": 0.25,
          "recency": 0.15,
          "impact": 0.25,
          "connectedness": 0.15
        },
        "total_score_max": 1.0
      },
      "triggers": ["session_compress"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 10
    },
    "memory-incremental-compressor": {
      "tool_id": "memory-incremental-compressor",
      "name": "Memory Incremental Compressor",
      "description": "记忆增量压缩工具 - LCS 算法识别重复，只存储差异部分",
      "version": "1.0",
      "command": "py 30-scripts-tools\\memory_incremental_compressor.py --diff --days {days}",
      "parameters": {
        "days": {
          "type": "integer",
          "required": false,
          "description": "处理最近 N 天",
          "default": 7,
          "min": 1,
          "max": 90
        }
      },
      "validation": {
        "algorithm": "LCS",
        "redundancy_threshold": 0.3
      },
      "triggers": ["weekly_sunday"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "auto-critic-v7": {
      "tool_id": "auto-critic-v7",
      "name": "Auto-Critic v7.0 Enhanced",
      "description": "增强版批判者 - 集成问题检测/整改闭环/质量门禁",
      "version": "7.0",
      "command": "py 30-scripts-tools\\auto-critic_v7.py -t \"{task}\" -p {phase} --create-remediation",
      "parameters": {
        "task": {
          "type": "string",
          "required": true,
          "description": "任务名称",
          "validation": "^[a-zA-Z0-9-_]+$"
        },
        "phase": {
          "type": "string",
          "required": true,
          "description": "审查阶段",
          "enum": ["start", "mid", "final"],
          "default": "final"
        }
      },
      "validation": {
        "review_file": "30-scripts-tools/critic-auto-{task}-v7.json",
        "score_threshold": 95,
        "blocker_items": [
          "致命问题 0 个",
          "工作区正确性",
          "代码/文档已提交 Git",
          "批判者自动调用",
          "无工具多份定义",
          "工作流无硬编码命令"
        ],
        "warning_items": [
          "严重问题≤2 个",
          "一般问题≤10 个",
          "当日笔记压缩<100 行",
          "会话压缩执行",
          "工具有效使用",
          "代码质量检查",
          "安全检查"
        ]
      },
      "triggers": ["session_end", "task_complete"],
      "review_required": true,
      "blocking": true,
      "timeout_seconds": 120,
      "components": ["issue_scanner", "critical_issue_detector", "remediation_tracker", "quality_gate"]
    },
    "issue-scanner": {
      "tool_id": "issue-scanner",
      "name": "Issue Scanner",
      "description": "问题扫描器 - 日志/静态分析/TODO/代码异味/安全扫描",
      "version": "1.0",
      "command": "py 30-scripts-tools\\issue_scanner.py --path {path} --format {format}",
      "parameters": {
        "path": {
          "type": "string",
          "required": false,
          "description": "扫描路径",
          "default": "30-scripts-tools"
        },
        "format": {
          "type": "string",
          "required": false,
          "description": "输出格式",
          "enum": ["text", "json"],
          "default": "text"
        }
      },
      "validation": {
        "categories": ["pylint", "flake8", "security", "complexity", "todo", "code_smell"],
        "severity_levels": ["critical", "high", "medium", "low", "info"]
      },
      "triggers": ["auto_critic_v7"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 60
    },
    "critical-issue-detector": {
      "tool_id": "critical-issue-detector",
      "name": "Critical Issue Detector",
      "description": "严重问题检测器 - 异常栈/核心模块变更/数据丢失风险",
      "version": "1.0",
      "command": "py 30-scripts-tools\\critical_issue_detector.py --path {path}",
      "parameters": {
        "path": {
          "type": "string",
          "required": false,
          "description": "扫描路径",
          "default": "."
        }
      },
      "validation": {
        "risk_levels": ["critical", "high", "medium", "low"],
        "categories": ["data_loss", "core_change", "security", "exception_stack"]
      },
      "triggers": ["auto_critic_v7"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 60
    },
    "remediation-tracker": {
      "tool_id": "remediation-tracker",
      "name": "Remediation Tracker",
      "description": "整改跟踪器 - 管理 FAIL 项整改闭环",
      "version": "1.0",
      "command": "py 30-scripts-tools\\remediation_tracker.py --create --fail-items {file}",
      "parameters": {
        "create": {
          "type": "boolean",
          "required": false,
          "description": "创建整改任务"
        },
        "fail-items": {
          "type": "string",
          "required": false,
          "description": "FAIL 项 JSON 文件"
        },
        "report": {
          "type": "boolean",
          "required": false,
          "description": "生成报告"
        }
      },
      "validation": {
        "task_status": ["open", "in_progress", "resolved", "verified", "closed", "overdue"],
        "severity_levels": ["blocker", "warning", "info"]
      },
      "triggers": ["auto_critic_v7_fail"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 30
    },
    "quality-gate": {
      "tool_id": "quality-gate",
      "name": "Quality Gate Checker",
      "description": "质量门禁 - 代码质量/安全/复杂度/测试覆盖率",
      "version": "1.0",
      "command": "py 30-scripts-tools\\quality_gate.py --check {pattern} --min-score {score}",
      "parameters": {
        "check": {
          "type": "string",
          "required": false,
          "description": "检查文件模式",
          "default": "30-scripts-tools/*.py"
        },
        "min-score": {
          "type": "integer",
          "required": false,
          "description": "最低通过分数",
          "default": 80,
          "min": 0,
          "max": 100
        }
      },
      "validation": {
        "min_passing_score": 80,
        "checks": ["pylint", "flake8", "security", "complexity", "test_coverage", "documentation"]
      },
      "triggers": ["auto_critic_v7"],
      "review_required": false,
      "blocking": false,
      "timeout_seconds": 60
    }
  },
  "workflows": {
    "session-end": {
      "workflow_id": "session-end",
      "description": "会话结束工作流 - 8 步自动化流程"
    },
    "task-complete": {
      "workflow_id": "task-complete",
      "description": "任务完成工作流 - 待创建"
    }
  },
  "compliance_rules": {
    "zero_score_items": [
      {
        "id": "ZS-001",
        "rule": "禁止为任何工具创建多份定义、副本、冗余内容",
        "check": "grep 重复 tool_id",
        "consequence": "0 分 + 阻断"
      },
      {
        "id": "ZS-002",
        "rule": "禁止在工作流中硬编码工具的执行逻辑、完整命令",
        "check": "grep 'py 30-scripts' in workflow files",
        "consequence": "0 分 + 阻断"
      },
      {
        "id": "ZS-003",
        "rule": "禁止修改工具引用时私自变更工具的核心逻辑",
        "check": "对比工具定义与工作流参数",
        "consequence": "0 分 + 阻断"
      },
      {
        "id": "ZS-004",
        "rule": "禁止绕过唯一工具库直接创建、执行未注册的工具",
        "check": "检查执行日志中的 tool_id",
        "consequence": "0 分 + 阻断"
      },
      {
        "id": "ZS-005",
        "rule": "禁止事后补录工具定义、补全引用",
        "check": "检查 Git 历史时间戳",
        "consequence": "0 分 + 阻断"
      },
      {
        "id": "ZS-006",
        "rule": "工具的「有效使用」判定：tool_id 被正式工作流引用",
        "check": "检查 workflow JSON 中的 tool_id 引用",
        "consequence": "未使用工具标记"
      },
      {
        "id": "ZS-007",
        "rule": "工具修改后必须自动触发变更标记和合规重审",
        "check": "检查变更日志和审查记录",
        "consequence": "0 分 + 阻断"
      }
    ],
    "review_checkpoints": {
      "pre_execution": [
        "工具是否在 tools_registry.json 中唯一定义",
        "tool_id 是否全局唯一（无重复）",
        "是否先定义再引用（顺序正确）"
      ],
      "during_execution": [
        "是否只引用 tool_id（无硬编码）",
        "是否实时读取工具库（无缓存）",
        "参数是否只覆盖非核心配置"
      ],
      "post_execution": [
        "是否有工具多份定义",
        "工作流是否硬编码命令",
        "是否绕过工具库",
        "是否事后补录定义",
        "工具修改是否触发变更标记",
        "执行是否使用最新版本"
      ]
    }
  }
}
