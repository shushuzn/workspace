  "description": "唯一工具库 - 全系统唯一真值来源",
  "principles": [
    "唯一数据源原则：所有工具只允许有一份唯一定义",
    "引用优先原则：工作流只引用 tool_id，禁止硬编码",
    "实时生效原则：工具修改后引用自动同步生效"
  ],
  "tools": {
    "auto-critic": {
      "tool_id": "auto-critic",
      "name": "Auto-Critic v6.0",
      "description": "全自动批判者审查工具 - 事前/事中/事后全流程审查",
      "version": "6.0",
      "command": "py 30-scripts-tools\\auto-critic.py -t \"{task}\" -p {phase}",
      "parameters": {
        "task": {
          "type": "string",
          "required": true,
          "description": "任务名称（用于生成审查文件名）",
          "validation": "^[a-zA-Z0-9-_]+$"
        },
        "phase": {
          "type": "string",
          "required": true,
          "description": "审查阶段",
          "enum": [
            "start",
            "mid",
            "final"
          ],
          "default": "final"
        }
      },
      "validation": {
        "review_file": "30-scripts-tools/critic-auto-{task}.json",
        "score_threshold": 95,
        "zero_score_items": [
          "批判者自动调用",
          "工具创建了必须使用",
          "当日笔记压缩<100 行",
          "会话压缩执行",
          "上下文大小验证<100KB",
          "工作区正确性 D 盘",
          "检查项必须有证据"
        ]
      },
      "triggers": [
        "session_end",
        "task_complete"
      ],
      "review_required": true,
      "blocking": false,
      "timeout_seconds": 60
    },
    "session-compress": {
      "tool_id": "session-compress",
