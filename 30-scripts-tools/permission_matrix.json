{
  "version": "1.0.0",
  "created_at": "2026-03-20T10:10:00+08:00",
  "principle": "最小权限原则 - 只授予完成任务所需的最小权限",
  
  "工具风险分级": {
    "L1_只读": {
      "description": "只读操作，无修改风险",
      "risk_level": "低",
      "auto_approve": true,
      "examples": [
        "read_file",
        "memory_search",
        "get_current_time",
        "get_token_usage",
        "view_image",
        "desktop_screenshot"
      ]
    },
    "L2_写入": {
      "description": "文件写入/修改操作",
      "risk_level": "中",
      "auto_approve": true,
      "requires_log": true,
      "examples": [
        "write_file",
        "edit_file",
        "git_commit_helper"
      ]
    },
    "L3_删除": {
      "description": "文件删除/移动操作",
      "risk_level": "高",
      "auto_approve": false,
      "requires_confirmation": true,
      "requires_backup": true,
      "examples": [
        "trash",
        "delete_file",
        "move_to_archive"
      ]
    },
    "L4_系统": {
      "description": "系统级操作（Shell 命令）",
      "risk_level": "极高",
      "auto_approve": false,
      "requires_confirmation": true,
      "requires_backup": true,
      "requires_audit": true,
      "examples": [
        "safe_shell_executor",
        "execute_system_command"
      ]
    },
    "L5_防护": {
      "description": "防护系统核心工具",
      "risk_level": "最高",
      "auto_approve": false,
      "requires_admin": true,
      "requires_audit": true,
      "examples": [
        "integrity_checker",
        "anti_bypass_engine",
        "emergency_stop",
        "file_guardian"
      ]
    }
  },
  
  "角色权限矩阵": {
    "Planner": {
      "description": "规划者 - 负责任务分解和规划",
      "allowed_levels": ["L1_只读", "L2_写入"],
      "denied_levels": ["L3_删除", "L4_系统", "L5_防护"],
      "max_tools_per_session": 50,
      "requires_confirmation_for": []
    },
    "Executor": {
      "description": "执行者 - 负责任务执行",
      "allowed_levels": ["L1_只读", "L2_写入", "L3_删除"],
      "denied_levels": ["L4_系统", "L5_防护"],
      "max_tools_per_session": 100,
      "requires_confirmation_for": ["L3_删除"]
    },
    "Critic": {
      "description": "批判者 - 负责质量审查",
      "allowed_levels": ["L1_只读"],
      "denied_levels": ["L2_写入", "L3_删除", "L4_系统", "L5_防护"],
      "max_tools_per_session": 30,
      "requires_confirmation_for": []
    },
    "Coordinator": {
      "description": "协调者 - 负责任务协调",
      "allowed_levels": ["L1_只读", "L2_写入"],
      "denied_levels": ["L3_删除", "L4_系统", "L5_防护"],
      "max_tools_per_session": 60,
      "requires_confirmation_for": []
    },
    "Admin": {
      "description": "管理员 - 拥有所有权限",
      "allowed_levels": ["L1_只读", "L2_写入", "L3_删除", "L4_系统", "L5_防护"],
      "denied_levels": [],
      "max_tools_per_session": -1,
      "requires_confirmation_for": ["L5_防护"]
    }
  },
  
