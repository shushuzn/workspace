#!/bin/sh
# Pre-commit hook: Validate file placement according to 12-core directory structure
# Ensures files are created in the correct directory based on type/purpose

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged files (new/modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Allowed SOUL.md and MEMORY.md in 00-CORE
ALLOWED_CORE_FILES="SOUL.md MEMORY.md AGENTS.md USER.md TOOLS.md IDENTITY.md HEARTBEAT.md TODO.md"

# Function to check if file is in correct directory
check_file_placement() {
    local file="$1"
    local filename=$(basename "$file")
    local dir=$(dirname "$file")
    local ext="${filename##*.}"
    local base="${filename%.*}"
    
    # Skip allowed files
    case "$filename" in
        README.md|LICENSE|.gitignore|.gitattributes|.env|config.json)
            return 0
            ;;
    esac
    
    # Check core identity files (must be in 00-CORE)
    for core in $ALLOWED_CORE_FILES; do
        if [ "$filename" = "$core" ]; then
            if [ "$dir" != "00-CORE" ] && [ "$dir" != "./00-CORE" ]; then
                echo -e "${RED}ERROR: $filename must be in 00-CORE/, not $dir/${NC}"
                return 1
            fi
            return 0
        fi
    done
    
    # Check file extensions and naming patterns
    case "$filename" in
        # Config files → 01-CONFIG
        *.json|*.yaml|*.yml|*.toml|*.ini|*.conf)
            if ! echo "$dir" | grep -qE "^(01-CONFIG|\.openclaw|obsidian)"; then
                echo -e "${YELLOW}WARNING: Config file $file should be in 01-CONFIG/${NC}"
            fi
            ;;
        
        # Python scripts → 40-TOOLS (unless in specific project dirs)
        *.py)
            if ! echo "$dir" | grep -qE "^(40-TOOLS|80-PROJECTS|30-AGENTS|20-MEMORY|10-RESEARCH|90-TESTS|70-DEPLOY)"; then
                echo -e "${YELLOW}WARNING: Python script $file should be categorized:"
                echo "  - 40-TOOLS/ for general tools"
                echo "  - 80-PROJECTS/ for project-specific code"
                echo "  - 30-AGENTS/ for agent-related code"
                echo "  - 90-TESTS/ for test files (test_*.py)"
            fi
            ;;
        
        # Test files → 90-TESTS
        test_*.py|*_test.py|*.test.js|test_*.ps1)
            if ! echo "$dir" | grep -qE "^90-TESTS"; then
                echo -e "${YELLOW}WARNING: Test file $file should be in 90-TESTS/${NC}"
            fi
            ;;
        
        # Documentation → appropriate directory or 99-ARCHIVE
        *.md)
            # Check if it's a report/summary (should go to 99-ARCHIVE or info in SOUL.md)
            case "$filename" in
                *report*.md|*REPORT*.md|*summary*.md|*SUMMARY*.md|*phase*.md|*PHASE*.md|*complete*.md|*COMPLETE*.md)
                    echo -e "${RED}ERROR: Report files like $filename are not allowed.${NC}"
                    echo "  Important info → 00-CORE/SOUL.md or 00-CORE/MEMORY.md"
                    echo "  Historical reports → 99-ARCHIVE/"
                    return 1
                    ;;
            esac
            ;;
        
        # HTML/CSS/JS → 50-DASHBOARD
        *.html|*.css|*.js)
            if ! echo "$dir" | grep -qE "^50-DASHBOARD"; then
                echo -e "${YELLOW}WARNING: Web file $file should be in 50-DASHBOARD/web/${NC}"
            fi
            ;;
        
        # Data files → 60-DATA
        *.csv|*.xlsx|*.jsonl|*.parquet|*.npy|*.npz|*.pkl|*.joblib)
            if ! echo "$dir" | grep -qE "^60-DATA"; then
                echo -e "${YELLOW}WARNING: Data file $file should be in 60-DATA/${NC}"
            fi
            ;;
        
        # Logs → logs/
        *.log)
            if ! echo "$dir" | grep -qE "^logs"; then
                echo -e "${YELLOW}WARNING: Log file $file should be in logs/${NC}"
            fi
            ;;
    esac
    
    return 0
}

# Main check
ERRORS=0
WARNINGS=0

echo "=== File Placement Validator ==="
echo ""

for file in $STAGED_FILES; do
    if ! check_file_placement "$file"; then
        ERRORS=$((ERRORS + 1))
    fi
done

echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ $ERRORS file(s) failed placement validation${NC}"
    echo ""
    echo "Directory Structure Reference:"
    echo "  00-CORE/       → Identity documents (SOUL.md, MEMORY.md, etc.)"
    echo "  01-CONFIG/     → Configuration files"
    echo "  10-RESEARCH/   → Research materials"
    echo "  20-MEMORY/     → Memory system files"
    echo "  30-AGENTS/     → Agent system"
    echo "  40-TOOLS/      → Tool scripts"
    echo "  50-DASHBOARD/  → Dashboard (web/api)"
    echo "  60-DATA/       → Data files"
    echo "  70-DEPLOY/     → Deployment scripts"
    echo "  80-PROJECTS/   → Project-specific code"
    echo "  90-TESTS/      → Test files"
    echo "  99-ARCHIVE/    → Historical archives"
    echo ""
    echo -e "${YELLOW}To bypass (emergency only): git commit --no-verify${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All files properly categorized${NC}"
exit 0
