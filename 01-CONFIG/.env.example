# Aliyun AccessKey Configuration
# ⚠️ NEVER commit this file to git!
# Copy this file to .env and fill in your real keys

ALIYUN_REGION=eu-west-1
ALIYUN_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
ALIYUN_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET_HERE
ALIYUN_INSTANCE_ID=YOUR_INSTANCE_ID_HERE

# Server Info
SERVER_IP=YOUR_SERVER_IP_HERE
SERVER_USER=root
SERVER_PASSWORD=YOUR_SERVER_PASSWORD_HERE


# GitHub Configuration
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_REPO=shushuzn/obsidian-sync
GITHUB_BRANCH=master
