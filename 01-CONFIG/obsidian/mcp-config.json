{
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\OpenClaw\\workspace"
      ],
      "description": "文件系统操作（读取/写入/搜索）",
      "enabled": true,
      "mode": "http",
      "port": 8080
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "description": "GitHub API（issues/PRs/repos）",
      "enabled": true,
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-notion"
      ],
      "description": "Notion API（页面/数据库/块）",
      "enabled": true,
      "env": {
        "NOTION_INTEGRATION_TOKEN": "${NOTION_INTEGRATION_TOKEN}"
      }
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "@tavily/mcp-server"
      ],
      "description": "Tavily 智能搜索（AI 优化）",
      "enabled": true,
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "description": "Slack 消息发送/频道管理",
      "enabled": false,
      "env": {
        "SLACK_TOKEN": "${SLACK_TOKEN}"
      }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost"
      ],
      "description": "PostgreSQL 数据库操作",
      "enabled": false
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "description": "网页内容抓取",
      "enabled": true
    }
  },
  "global": {
    "timeout_seconds": 60,
    "retry": {
      "enabled": true,
      "max_attempts": 3,
      "delay_seconds": 1
    },
    "logging": {
      "enabled": true,
      "level": "info"
    }
  }
}