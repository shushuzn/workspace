{
  "version": "1.0",
  "timezone": "Asia/Hong_Kong",
  "tasks": [
    {
      "name": "HEARTBEAT Auto-Workflow",
      "description": "7-persona automated workflow every 30 minutes",
      "command": "python 30-scripts-tools/heartbeat_workflow.py",
      "schedule": "*/30 * * * *",
      "enabled": true,
      "priority": "high",
      "timeout_minutes": 10,
      "retry_on_error": true,
      "max_retries": 3,
      "notification": {
        "on_complete": true,
        "on_error": true,
        "channel": "feishu"
      }
    },
    {
      "name": "Memory Distiller",
      "description": "Weekly memory distillation every Sunday 5AM",
      "command": "python memory-distiller.py --weekly",
      "schedule": "0 5 * * 0",
      "enabled": true,
      "priority": "medium",
      "timeout_minutes": 30,
      "retry_on_error": true,
      "max_retries": 2,
      "notification": {
        "on_complete": true,
        "on_error": true,
        "channel": "feishu"
      }
    },
    {
      "name": "Memory Maintenance",
      "description": "Daily memory quality check at 23:00",
      "command": "python memory-maintenance.py",
      "schedule": "0 23 * * *",
      "enabled": true,
      "priority": "medium",
      "timeout_minutes": 15,
      "retry_on_error": true,
      "max_retries": 2,
      "notification": {
        "on_complete": false,
        "on_error": true,
        "channel": "feishu"
      }
    },
    {
      "name": "arXiv Collector",
      "description": "Daily arXiv paper collection at 7AM",
      "command": "python 40-collectors/arxiv_collector.py --categories CNT,AI,Agent --limit 50",
      "schedule": "0 7 * * *",
      "enabled": true,
      "priority": "medium",
      "timeout_minutes": 20,
      "retry_on_error": true,
      "max_retries": 2,
      "notification": {
        "on_complete": true,
        "on_error": true,
        "channel": "feishu"
      }
    },
    {
      "name": "Daily Brief Generator",
      "description": "Daily research brief at 8AM",
      "command": "python 30-scripts-tools/daily_brief_generator.py",
      "schedule": "0 8 * * *",
      "enabled": true,
      "priority": "high",
      "timeout_minutes": 15,
      "retry_on_error": true,
      "max_retries": 2,
      "notification": {
        "on_complete": true,
        "on_error": true,
        "channel": "feishu"
      }
    }
  ]
}
