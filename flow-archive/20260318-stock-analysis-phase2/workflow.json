    {
      "step_id": 6,
      "name": "支撑阻力分析",
      "description": "识别支撑位和阻力位 (SA-008)",
      "tool_id": "SA-008",
      "stage": "analysis",
      "parameters": {
        "pivot_window": 5,
        "psychological_levels": true,
        "volume_profile": true
      },
      "blocking": true
    },
    {
      "step_id": 7,
      "name": "信号生成",
      "description": "综合所有分析生成交易信号",
