{
  "flow_id": "20260318-stock-analysis-phase2",
  "name": "股票分析 Phase 2 - 技术分析引擎",
  "description": "股票分析系统 Phase 2 - 包含技术指标、形态识别、趋势分析、支撑阻力等",
  "version": "1.0.0",
