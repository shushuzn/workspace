    {
      "step_id": 8,
      "name": "风险评估",
      "description": "风险评估和管理",
      "tool_id": "SA-009",
      "stage": "analysis",
      "parameters": {
        "risk_metrics": ["volatility", "max_drawdown", "var"]
      },
      "blocking": true
    },
    {
