        "period": "1y",
        "interval": "1d"
      },
      "blocking": true
    },
    {
      "step_id": 2,
      "name": "参数配置",
      "description": "配置技术分析参数",
      "tool_id": "config_manager",
      "stage": "initialization",
      "parameters": {
        "ma_periods": [5, 10, 20, 60],
        "rsi_period": 14,
        "macd_fast": 12,
        "macd_slow": 26,
        "boll_period": 20,
        "boll_std": 2
      },
      "blocking": true
    },
    {
      "step_id": 3,
      "name": "技术指标计算",
      "description": "计算 11+ 技术指标 (SA-005)",
      "tool_id": "SA-005",
      "stage": "analysis",
      "parameters": {
        "indicators": ["MA", "MACD", "RSI", "KDJ", "BOLL", "ATR"]
      },
      "blocking": true
    },
    {
      "step_id": 4,
      "name": "形态识别",
      "description": "K 线形态和趋势形态识别 (SA-006)",
      "tool_id": "SA-006",
      "stage": "analysis",
      "parameters": {
        "patterns": ["candlestick", "engulfing", "head_shoulders", "double_top_bottom"]
      },
      "blocking": true
    },
    {
      "step_id": 5,
      "name": "趋势分析",
      "description": "趋势方向和强度分析 (SA-007)",
      "tool_id": "SA-007",
      "stage": "analysis",
      "parameters": {
        "ma_trend": true,
        "macd_trend": true,
        "adx_strength": true
      },
      "blocking": true
