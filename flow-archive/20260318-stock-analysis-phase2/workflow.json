      "parameters": {
        "min_score": 80,
        "check_types": ["code_quality", "logic", "performance"]
      },
      "blocking": true
    },
    {
      "step_id": 10,
      "name": "质量门禁",
      "description": "最终质量检查",
      "tool_id": "quality_gate",
      "stage": "validation",
      "parameters": {
        "min_test_coverage": 0.8,
        "required_tests": ["unit", "integration"]
