{
  "template_id": "research-001",
  "name": "研究任务工作流",
  "version": "1.0.0",
  "description": "适用于学术研究、数据分析、实验报告等研究类任务",
  "total_steps": 10,
  "estimated_time": "30-60 分钟",
  "steps": [
    {
      "step": 1,
      "name": "上下文加载验证",
      "blocker": true,
      "tool": "context_verify",
      "description": "加载 7 核心文件，验证上下文"
    },
    {
      "step": 2,
      "name": "Flow ID 绑定",
      "blocker": true,
      "tool": "flow_id_bind",
      "description": "绑定到 research-001 工作流"
    },
    {
      "step": 3,
      "name": "研究问题定义",
      "blocker": true,
      "tool": "task_parser",
      "description": "明确研究问题、假设、目标"
    },
    {
      "step": 4,
      "name": "文献调研",
      "blocker": true,
      "tool": "literature_review",
      "description": "搜索相关文献，整理参考文献"
    },
    {
      "step": 5,
      "name": "数据收集",
      "blocker": true,
      "tool": "data_collector",
      "description": "收集实验数据、调查数据等"
    },
    {
      "step": 6,
      "name": "数据分析",
      "blocker": true,
      "tool": "data_analyzer",
      "description": "统计分析、可视化、建模"
    },
    {
      "step": 7,
      "name": "结果解释",
      "blocker": true,
      "tool": "result_interpreter",
      "description": "解释分析结果，验证假设"
    },
    {
      "step": 8,
      "name": "批判者审查",
      "blocker": true,
      "tool": "auto-critic_v7",
      "description": "研究质量审查（科研严谨性）"
    },
    {
      "step": 9,
      "name": "报告撰写",
      "blocker": true,
      "tool": "report_writer",
      "description": "撰写研究报告/论文"
    },
    {
      "step": 10,
      "name": "Git 提交推送",
      "blocker": true,
      "tool": "git_commit_push",
      "description": "提交代码、数据、报告到 Git"
    }
  ],
  "quality_gates": {
    "step_8": {
      "critical_issues": 0,
      "severe_issues": 2,
      "minor_issues": 10,
      "min_score": 85
    }
  },
  "deliverables": [
    "研究报告.md",
    "数据分析.ipynb",
    "参考文献.bib",
    "原始数据/",
    "结果图表/"
  ]
}
