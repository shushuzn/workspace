{
  "description": "OMC Hooks — Session lifecycle + active learning",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-auto-seed.mjs --check",
            "timeout": 1000
          },
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-active-learn.mjs",
            "timeout": 1000
          },
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-posttool-reflect.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-pretool-brainstorm-verify.mjs",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-pretool-reflect.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-session-start-inject.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/OpenClaw/workspace/.omc/scripts/hook-session-end-drain.mjs",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
