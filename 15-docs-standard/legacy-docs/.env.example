# ===========================================
# OpenClaw Workspace - API 密钥配置模板
# ===========================================
# 📋 使用说明:
# 1. 复制此文件为 .env
# 2. 填写真实的 API 密钥
# 3. 切勿将 .env 提交到 Git
# ===========================================

# 📚 学术数据 API
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
ARXIV_BASE_URL=https://export.arxiv.org/api/query
SERPAPI_KEY=your_serpapi_key_here

# 💻 代码与开源 API
GITHUB_TOKEN=your_github_token_here
PYPI_BASE_URL=https://pypi.org/pypi/

# 💰 资金与专利 API
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
NSF_API_BASE_URL=https://api.nsf.gov/services/v1/awards.json
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# 🎓 教育 API
COURSERA_API_KEY=your_coursera_api_key_here
EDX_API_KEY=your_edx_api_key_here
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# 🌐 国际合作 API
ORCID_CLIENT_ID=your_orcid_client_id_here
ORCID_CLIENT_SECRET=your_orcid_client_secret_here
CROSSREF_MAILTO=your_email@example.com

# 📊 数据分析 API
OPENALEX_API_BASE_URL=https://api.openalex.org
DIMENSIONS_API_KEY=your_dimensions_api_key_here

# 🤖 AI 服务 API
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# 📡 通知与推送 API
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_here
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token_here
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here

# 🗺️ 其他服务 API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=your_openweather_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
HACKERNEWS_API_URL=https://hacker-news.firebaseio.com/v0/

# 📁 本地配置
WORKSPACE_DIR=D:/OpenClaw/workspace
CACHE_DIR=D:/OpenClaw/workspace/.cache
LOG_LEVEL=INFO
DATA_UPDATE_INTERVAL=7

# 🔐 安全设置
ENCRYPTION_KEY=your_encryption_key_here_32chars
API_TIMEOUT=30
API_MAX_RETRIES=3
