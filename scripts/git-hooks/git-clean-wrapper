#!/usr/bin/env python3
import sys, os

def main():
    args = sys.argv[1:]
    if any(a in ('-n', '--dry-run') or (a.startswith('-') and not a.startswith('--') and 'n' in a.lstrip('-')) for a in args):
        sys.exit(0)
    has_force = any(a.startswith('-') and 'f' in a.lstrip('-') for a in args)
    has_recursive = any(a.startswith('-') and 'd' in a.lstrip('-') for a in args)
    if not (has_force and has_recursive):
        sys.exit(0)
    print()
    print('=' * 60)
    print('DANGEROUS: git clean -fd')
    print('=' * 60)
    print('  Will permanently delete ALL untracked files.')
    print('  Safe: git clean -fd -n (preview)')
    print('=' * 60)
    try:
        resp = input('Type YES to confirm: ').strip()
    except (EOFError, OSError):
        print('Cannot confirm (non-interactive). Aborted.')
        sys.exit(1)
    sys.exit(0 if resp == 'YES' else 1)

if __name__ == '__main__':
    main()
