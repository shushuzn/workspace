# CI-specific gitignore entries
# Add this to your project's .gitignore: reference shared/.ci-gitignore

# npm CI artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and test configs
.env
.env.local
.env.*.local
.env.test
.env.test.local
.env.development
.env.development.local

# Test coverage
coverage/
coverage-badge.*
*.lcov.info

# Build artifacts
dist-node/
build/
out/
.next/

# CI system artifacts
.tap/
.nyc_output/
.pytest_cache/
.phpunit.result.cache
jest-junit.xml
test-results/

# Temporary files from check scripts
*.check.tmp
.tmp/
temp/
tmp/
