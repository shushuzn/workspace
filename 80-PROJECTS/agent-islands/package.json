{
  "name": "agent-islands",
  "version": "1.0.0",
  "description": "Multi-Agent Orchestration Platform based on MCP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "demo": "tsx src/examples/basic.ts",
    "dashboard": "npx serve dashboard"
  },
  "keywords": [
    "multi-agent",
    "MCP",
    "orchestration",
    "AI",
    "agent"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "repository": "https://github.com/shushuzn/agent-islands.git",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  }
}
