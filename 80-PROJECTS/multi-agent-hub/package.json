{
  "name": "multi-agent-hub",
  "version": "1.0.0",
  "description": "Multi-agent orchestration platform - debate, news, code analysis via MCP",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shushuzn/multi-agent-hub.git"
  },
  "keywords": [
    "CLI",
    "multi-agent",
    "discussion",
    "AI",
    "MiniMax"
  ],
  "scripts": {
    "start": "node index.js",
    "mcp": "node mcp.ts",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.0.0",
    "https-proxy-agent": "^8.0.0",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "undici": "^7.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prom-client": "^15.1.3",
    "standard-changelog": "^7.0.1"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shushuzn/ai-roundtable/issues"
  },
  "homepage": "https://github.com/shushuzn/ai-roundtable#readme"
}
