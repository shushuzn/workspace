    },
    {
      "parameters": {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\OpenClaw\\workspace\\scripts\\obsidian-auto-sync.ps1\"",
        "options": {}
      },
      "id": "obsidian-sync",
      "name": "Obsidian Sync",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1.0,
      "position": [220, 0]
    },
    {
      "parameters": {
        "rule": {
          "cron": {
            "expression": "0 2 * * *"
          }
        }
      },
      "id": "daily-2am",
      "name": "Daily 2AM - arXiv",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "command": "py D:\\npm-global\\node_modules\\openclaw\\skills\\arxiv-daily\\scripts\\arxiv-daily.py --categories cs.AI,cs.LG,cs.CL --output D:\\OpenClaw\\workspace\\Medium\\Raw\\ --days 1",
        "options": {}
      },
      "id": "arxiv-collect",
      "name": "arXiv Collect",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1.0,
      "position": [220, 200]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout || '';\nconst match = output.match(/New papers: (\\d+)/);\nconst newPapers = match ? parseInt(match[1]) : 0;\nconst highPriority = output.match(/High priority papers: (\\d+)/);\nconst highPriorityCount = highPriority ? parseInt(highPriority[1]) : 0;\n\nreturn {\n  newPapers,\n  highPriorityCount,\n  shouldParse: highPriorityCount >= 3,\n  message: `收集 ${newPapers} 篇，高优先级 ${highPriorityCount} 篇`\n};"
      },
      "id": "parse-arxiv-output",
      "name": "Parse arXiv Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "valueA": "={{ $json.highPriorityCount }}",
              "valueB": 3,
              "operation": "largerEqual"
            }
          ]
        }
      },
      "id": "check-parse-threshold",
      "name": "Check Parse Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 200]
    },
    {
      "parameters": {
        "command": "py D:\\npm-global\\node_modules\\openclaw\\skills\\batch-processor\\scripts\\batch-processor.py --auto --max-concurrent 4",
        "options": {}
      },
      "id": "batch-parse",
      "name": "Batch Parse",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1.0,
      "position": [880, 150]
    },
    {
      "parameters": {
        "rule": {
          "cron": {
            "expression": "0 3 * * *"
          }
        }
      },
