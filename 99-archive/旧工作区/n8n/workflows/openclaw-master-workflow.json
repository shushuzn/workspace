      "id": "weekly-10am-mon",
      "name": "Weekly 10AM Mon - Report",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 1200]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst lastWeek = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nreturn {\n  weekStart: lastWeek.toISOString().split('T')[0],\n  weekEnd: now.toISOString().split('T')[0],\n  message: `生成周报：${lastWeek.toISOString().split('T')[0]} ~ ${now.toISOString().split('T')[0]}`\n};"
      },
      "id": "generate-report",
      "name": "Generate Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 1200]
    }
