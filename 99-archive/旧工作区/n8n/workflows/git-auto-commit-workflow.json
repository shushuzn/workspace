{
  "name": "Git 自动提交流程",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "every-2h",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "cd D:\\obsidian\\Vault; $changed = git status --porcelain; if ($changed) { git add -A; git commit -m \"[auto-commit] $(Get-Date -Format 'yyyy-MM-dd HH:mm')\"; git push } else { Write-Host \"No changes\" }",
        "options": {
          "cwd": "D:\\obsidian\\Vault"
        }
      },
      "id": "git-commit",
      "name": "Git Commit & Push",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1.0,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout || '';\nreturn {\n  hasChanges: output !== 'No changes',\n  message: output\n};"
      },
      "id": "check-result",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Every 2 Hours": {
      "main": [
        [
          {
            "node": "Git Commit & Push",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Git Commit & Push": {
      "main": [
        [
          {
            "node": "Check Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "OpenClaw"
    },
    {
      "name": "Git"
    }
  ]
}
